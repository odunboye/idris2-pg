package idris2-pg
version = 0.1.0
authors = "Odun Adeboye"
-- maintainers =
license = "MIT"
brief = "A from-scratch PostgreSQL wire-protocol client (no libpq)"
readme = "README.md"
homepage = "https://github.com/odunboye/idris2-pg"
sourceloc = "https://github.com/odunboye/idris2-pg"
bugtracker = "https://github.com/odunboye/idris2-pg/issues"

-- the Idris2 version required (e.g. langversion >= 0.5.1)
-- langversion

-- packages to add to search path
 depends = network
        ,  elab-util

-- modules to install
modules = Network.Core
        , Network.RawSocket
        , Data.PGTypes
        , Data.PGValue
        , Crypto.MD5
        , Helper
        , Idris2_pg

-- main file (i.e. file to load at REPL)
-- main =

-- name of executable
-- executable =
-- opts =
sourcedir = "src"
-- builddir =
-- outputdir =

-- script to run before building
-- prebuild =

-- script to run after building
-- postbuild =

-- script to run after building, before installing
-- preinstall =

-- script to run after installing
-- postinstall =

-- script to run before cleaning
-- preclean =

-- script to run after cleaning
-- postclean =
